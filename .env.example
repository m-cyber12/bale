# ============================================================
#  نمونه‌ی متغیرهای محیطی — این فایل را کپی کن به .env یا
#  در Render → Environment وارد کن. هیچ‌وقت .env را کامیت نکن.
# ============================================================

# ---------- پیام‌رسان‌ها (هر کدام که می‌خواهی) ----------
# bale,telegram  یا فقط bale  یا webhook
PLATFORMS=bale

# توکن ربات بله (از BotFather بله)
BALE_TOKEN=

# توکن ربات تلگرام (از @BotFather)
TELEGRAM_TOKEN=

# برای پیام‌رسان دلخواه (وب‌هوک)
WEBHOOK_SEND_URL=
WEBHOOK_TOKEN=

# ---------- هوش مصنوعی ----------
OPENROUTER_API_KEY=

# ---------- ربات ----------
# ------------------------------------------------------------
#  مالک ربات (یکی از این دو راه — نه هر دو)
# ------------------------------------------------------------
# راه ۱: آیدی عددی (مطمئن‌ترین). اگر عدد را نمی‌دانی، در پیوی ربات بنویس: آیدی من
OWNER_ID=
# راه ۲: نام کاربری (اگر آیدی عددی را نمی‌دانی) — خودِ ربات با اولین پیام، عددش را ثبت می‌کند
# OWNER_USERNAME=Spinner5698

# پوشه‌ی داده‌ها (روی Render با دیسک: /var/data)
DATA_DIR=data
